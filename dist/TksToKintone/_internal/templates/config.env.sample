# TKS契約会社コード。画面には表示のみで、利用者は通常変更しません。
TKS_COMPANY_CODE=G29V-T8GL-9LYD

# TKS接続方式。
# mock: ローカルCSVを使って変換処理だけ確認します。
# http: TKS OLAPへ実接続します。
TKS_CLIENT_MODE=http

# mockモード用CSVパス。file:// で始まるフルパスを指定します。
# 加工抽出ロジックCSV。
TKS_KAKOU_CSV_URL=file://C:/ProgramData/Manekiya/TksToKintone/sample/kakou.csv
# 素板抽出ロジックCSV。
TKS_SOBA_CSV_URL=file://C:/ProgramData/Manekiya/TksToKintone/sample/soba.csv

# httpモード用TKS OLAPベースURL。
# 例: https://www.ap.tkscloud8.aga-sys.com
# アプリ内部で /c/ログイン認証 と /c/OLAPデータ を付与します。
TKS_BASE_URL=https://www.ap.tkscloud8.aga-sys.com

# TKSへ送るScreenName。通常は0です。
TKS_SCREEN_NAME=0

# ログイン認証区分。TKS側の指定値を設定します。通信ログ例では2です。
TKS_LOGIN_AUTH_KBN=2

# 端末識別ID。TKS通信ログの「端末識別ID」に合わせます。
TKS_TERMINAL_ID={CEC0285A-6796-4DFF-8D8A-70D896824E2E}

# コンピュータ名。空の場合は実行PCのホスト名を使用します。
TKS_COMPUTER_NAME=DESKTOP-FG06QMO

# IPアドレス。TKS側で必要な場合に設定します。
TKS_IP_ADDRESS=fe80::1f5d:5027:5efe:42e1%5

# 加工抽出ロジックのPUT /c/OLAPデータ リクエストJSONテンプレート。
# 実行時はR2List内の フィールド論理名=受注No の OLAP値 だけ差し替えます。
TKS_KAKOU_REQUEST_TEMPLATE=docs/olap/kakou_request_template.json

# 素板抽出ロジックのPUT /c/OLAPデータ リクエストJSONテンプレート。
# 実行時はR2List内の フィールド論理名=受注No の OLAP値 だけ差し替えます。
TKS_SOBA_REQUEST_TEMPLATE=docs/olap/soba_request_template.json

# 売上伝票PDF用OLAPのOP関連追加項目を除外します。
# TKS_VOUCHER_OLAP_ENABLED_OP_FIELDS が設定されている場合はそちらが優先されます。
TKS_VOUCHER_OLAP_DISABLE_OP_FIELDS=1

# OLAPから取得するOP追加項目をカンマ区切りで指定します。
# 02時平米・02時総平米・00時ケース・ロット平米はOLAPから取得せずアプリ側で計算します。
# 設定するとTKS_VOUCHER_OLAP_DISABLE_OP_FIELDSより優先されます。
TKS_VOUCHER_OLAP_ENABLED_OP_FIELDS=OP区分,商品コード

# kintoneのドメイン。https:// は付けても付けなくても構いません。
KINTONE_DOMAIN=https://manekiya.cybozu.com

# kintoneアプリID。
KINTONE_APP_ID=255

# kintone APIトークン。ログには出力しません。
KINTONE_API_TOKEN=bahbbohyf2BqilmTveZep2Um6Ti1WCThCMW4SkbW

# ProgramData配下の作業フォルダ名。
OUTPUT_DIR=work

# 伝票PDFの出力先。空の場合は ProgramData 配下の work/voucher_output を使用します。
VOUCHER_OUTPUT_DIR=

# ProgramData配下のログフォルダ名。
LOG_DIR=logs

# ProgramData配下のエラーCSVフォルダ名。
ERROR_DIR=error

# CSV文字コード。TKS/Excel向けは通常cp932です。
CSV_ENCODING=cp932

# 画面の出荷区分候補。カンマ区切りで指定します。
SHUKKA_KBN_OPTIONS=AM,PM

# 古い作業ファイル・ログの自動削除日数
CLEANUP_RETENTION_DAYS=7

# 新規行の「印刷する伝票」初期チェック状態（伝票種別IDのカンマ区切り）
# 01=売上伝票 02=工場控 03=指図書(1) 04=指図書(2)
# 05=梱包明細書 06=配送指示書 07=納品書 08=受領書
# 伝票作成・印刷画面の「印刷する伝票設定」ボタンから変更できます。
VOUCHER_DEFAULT_PRINT_TYPES=01,02,03,04,05,06,07,08

# OLAP取得データ（受注Noごと）のキャッシュ保存期間（日数）。デフォルト7日。
VOUCHER_CACHE_RETENTION_DAYS=7

# 得意先ヘッダー表示名
# 加工名マスタ画面と登録前確認画面の得意先1〜4の表示名に使います。
# アプリの「得意先ヘッダー設定」ボタンから変更できます。
# 内部キーとCSV列名は 得意先1〜得意先4 のままです。最大20文字。
CUSTOMER_LABEL_1=得意先1
CUSTOMER_LABEL_2=得意先2
CUSTOMER_LABEL_3=得意先3
CUSTOMER_LABEL_4=得意先4

# 登録前確認画面のテーブル配色テーマ
# light / dark / auto
# auto は QPalette で自動判定しますが環境によって不安定なことがあります。
# ライトテーマ使用時は light、ダークテーマ使用時は dark を明示指定してください。
PREVIEW_COLOR_THEME=light
